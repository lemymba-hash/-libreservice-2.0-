# Copiez ce fichier en ".env" et adaptez les valeurs

# Port du serveur
PORT=3000

# Cle secrete utilisee pour signer les tokens JWT (mettez une chaine longue et aleatoire en production)
JWT_SECRET=change_moi_en_production_super_secret

# Duree de validite du token (format jsonwebtoken)
JWT_EXPIRES_IN=7d

# Identifiant / mot de passe du compte admin cree automatiquement au premier demarrage
ADMIN_EMAIL=admin@libreservice.ga
ADMIN_PASSWORD=admin123
